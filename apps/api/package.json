{
  "name": "@rincon/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "predev": "node ../../scripts/clean-legacy-offline.mjs && node ../../scripts/assert-release.mjs",
    "dev": "dotenv -e ../../.env -- nest start --watch",
    "prebuild": "node ../../scripts/clean-legacy-offline.mjs && node ../../scripts/assert-release.mjs",
    "build": "dotenv -e ../../.env -- nest build",
    "start": "dotenv -e ../../.env -- node dist/src/main.js",
    "lint": "eslint \"{src,prisma}/**/*.ts\"",
    "test": "jest --runInBand --passWithNoTests",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "11.4.6",
    "@prisma/client": "^6.14.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@nestjs/cli": "^11.0.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "jest": "^30.1.1",
    "prettier": "^3.6.2",
    "prisma": "^6.14.0",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": { "^.+\\.(t|j)s$": "ts-jest" },
    "testEnvironment": "node"
  }
}

generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum RoundingMode {
  NONE
  TEN
  FIFTY
  HUNDRED
}
enum UnitType {
  UNIT
  KG
  GRAM
  LITER
  METER
}

model Company {
  id String @id @default(uuid()) @db.Uuid
  name String
  legalName String?
  cuit String? @unique
  phone String?
  email String?
  address String?
  city String?
  province String?
  country String @default("Argentina")
  currency String @default("ARS")
  timezone String @default("America/Argentina/Buenos_Aires")
  logoUrl String?
  defaultMargin Decimal @default(30) @db.Decimal(7,2)
  roundingMode RoundingMode @default(TEN)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branches Branch[]
  users User[]
  roles Role[]
  permissions Permission[]
  categories Category[]
  brands Brand[]
  products Product[]
}
model Branch {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  company Company @relation(fields:[companyId],references:[id])
  name String
  code String
  address String?
  city String?
  province String?
  phone String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  users User[]
  productConfigs BranchProduct[]
  priceHistory PriceHistory[]
  costHistory CostHistory[]
  @@unique([companyId,code])
  @@index([companyId,active])
}
model User {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  company Company @relation(fields:[companyId],references:[id])
  branchId String? @db.Uuid
  branch Branch? @relation(fields:[branchId],references:[id])
  username String
  email String?
  passwordHash String
  firstName String
  lastName String
  active Boolean @default(true)
  lastLoginAt DateTime?
  tokenVersion Int @default(0)
  refreshTokenHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  roles UserRole[]
  priceChanges PriceHistory[]
  costChanges CostHistory[]
  @@unique([companyId,username])
  @@unique([companyId,email])
  @@index([companyId,branchId,active])
  @@index([email])
}
model Role {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  company Company @relation(fields:[companyId],references:[id])
  code String
  name String
  description String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  permissions RolePermission[]
  users UserRole[]
  @@unique([companyId,code])
  @@index([companyId,active])
}
model Permission {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  company Company @relation(fields:[companyId],references:[id])
  code String
  description String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  roles RolePermission[]
  @@unique([companyId,code])
  @@index([companyId])
}
model RolePermission {
  roleId String @db.Uuid
  permissionId String @db.Uuid
  role Role @relation(fields:[roleId],references:[id],onDelete:Cascade)
  permission Permission @relation(fields:[permissionId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  @@id([roleId,permissionId])
}
model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  role Role @relation(fields:[roleId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  @@id([userId,roleId])
  @@index([roleId])
}
model Category {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  company Company @relation(fields:[companyId],references:[id])
  name String
  description String?
  parentId String? @db.Uuid
  parent Category? @relation("CategoryTree",fields:[parentId],references:[id])
  children Category[] @relation("CategoryTree")
  active Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  products Product[]
  @@unique([companyId,name,parentId])
  @@index([companyId,active])
  @@index([parentId])
}
model Brand {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  company Company @relation(fields:[companyId],references:[id])
  name String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  products Product[]
  @@unique([companyId,name])
  @@index([companyId,active])
}
model Product {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  company Company @relation(fields:[companyId],references:[id])
  categoryId String @db.Uuid
  category Category @relation(fields:[categoryId],references:[id])
  brandId String? @db.Uuid
  brand Brand? @relation(fields:[brandId],references:[id])
  internalCode String
  name String
  description String?
  unitType UnitType @default(UNIT)
  taxRate Decimal @default(21) @db.Decimal(5,2)
  imageUrl String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  barcodes ProductBarcode[]
  branchConfigs BranchProduct[]
  priceHistory PriceHistory[]
  costHistory CostHistory[]
  @@unique([companyId,internalCode])
  @@index([companyId,active,name])
  @@index([categoryId])
  @@index([brandId])
}
model ProductBarcode {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  productId String @db.Uuid
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  barcode String
  isPrimary Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([companyId,barcode])
  @@index([productId])
}
model BranchProduct {
  id String @id @default(uuid()) @db.Uuid
  branchId String @db.Uuid
  productId String @db.Uuid
  branch Branch @relation(fields:[branchId],references:[id])
  product Product @relation(fields:[productId],references:[id])
  cost Decimal @default(0) @db.Decimal(14,2)
  salePrice Decimal @default(0) @db.Decimal(14,2)
  margin Decimal @default(0) @db.Decimal(9,2)
  stockMinimum Decimal @default(0) @db.Decimal(14,3)
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([branchId,productId])
  @@index([branchId,enabled])
  @@index([productId])
}
model PriceHistory {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  branchId String @db.Uuid
  oldPrice Decimal @db.Decimal(14,2)
  newPrice Decimal @db.Decimal(14,2)
  changedByUserId String @db.Uuid
  product Product @relation(fields:[productId],references:[id])
  branch Branch @relation(fields:[branchId],references:[id])
  changedBy User @relation(fields:[changedByUserId],references:[id])
  createdAt DateTime @default(now())
  @@index([productId,branchId,createdAt])
}
model CostHistory {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  branchId String @db.Uuid
  oldCost Decimal @db.Decimal(14,2)
  newCost Decimal @db.Decimal(14,2)
  changedByUserId String @db.Uuid
  product Product @relation(fields:[productId],references:[id])
  branch Branch @relation(fields:[branchId],references:[id])
  changedBy User @relation(fields:[changedByUserId],references:[id])
  createdAt DateTime @default(now())
  @@index([productId,branchId,createdAt])
}

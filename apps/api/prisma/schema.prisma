generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

enum PricePolicy { GENERAL BRANCH }
enum Unit { UNIT KILOGRAM GRAM LITER METER }

model Company {
  id String @id @default(uuid()) @db.Uuid
  name String
  taxId String? @unique
  currency String @default("ARS")
  timezone String @default("America/Argentina/Buenos_Aires")
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branches Branch[]
  users User[]
  roles Role[]
  permissions Permission[]
  categories Category[]
  brands Brand[]
  products Product[]
}

model Branch {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  company Company @relation(fields: [companyId], references: [id])
  code String
  name String
  address String?
  city String?
  province String?
  phone String?
  pricePolicy PricePolicy @default(GENERAL)
  active Boolean @default(true)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users User[]
  products BranchProduct[]
  @@unique([companyId, code])
  @@index([companyId, active])
}

model User {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  company Company @relation(fields: [companyId], references: [id])
  branchId String? @db.Uuid
  branch Branch? @relation(fields: [branchId], references: [id])
  roleId String @db.Uuid
  role Role @relation(fields: [roleId], references: [id])
  username String
  email String
  passwordHash String
  firstName String
  lastName String
  active Boolean @default(true)
  deletedAt DateTime?
  tokenVersion Int @default(0)
  refreshTokenHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([companyId, username])
  @@unique([companyId, email])
  @@index([companyId, branchId])
}

model Role {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  company Company @relation(fields: [companyId], references: [id])
  code String
  name String
  system Boolean @default(false)
  users User[]
  permissions RolePermission[]
  @@unique([companyId, code])
}

model Permission {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  company Company @relation(fields: [companyId], references: [id])
  code String
  description String
  roles RolePermission[]
  @@unique([companyId, code])
}

model RolePermission {
  roleId String @db.Uuid
  permissionId String @db.Uuid
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model Category {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  company Company @relation(fields: [companyId], references: [id])
  parentId String? @db.Uuid
  parent Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  name String
  slug String
  active Boolean @default(true)
  deletedAt DateTime?
  products Product[]
  @@unique([companyId, slug])
}

model Brand {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  company Company @relation(fields: [companyId], references: [id])
  name String
  active Boolean @default(true)
  products Product[]
  @@unique([companyId, name])
}

model Product {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  company Company @relation(fields: [companyId], references: [id])
  categoryId String @db.Uuid
  category Category @relation(fields: [categoryId], references: [id])
  brandId String? @db.Uuid
  brand Brand? @relation(fields: [brandId], references: [id])
  internalCode String
  name String
  description String?
  unit Unit @default(UNIT)
  cost Decimal @db.Decimal(14, 2)
  generalPrice Decimal @db.Decimal(14, 2)
  taxRate Decimal @default(21) @db.Decimal(5, 2)
  active Boolean @default(true)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  barcodes ProductBarcode[]
  branches BranchProduct[]
  @@unique([companyId, internalCode])
  @@index([companyId, name])
}

model ProductBarcode {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  code String @unique
  primary Boolean @default(false)
}

model BranchProduct {
  branchId String @db.Uuid
  productId String @db.Uuid
  branch Branch @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  price Decimal? @db.Decimal(14, 2)
  minimumStock Decimal @default(0) @db.Decimal(14, 3)
  enabled Boolean @default(true)
  version Int @default(1)
  updatedAt DateTime @updatedAt
  @@id([branchId, productId])
}

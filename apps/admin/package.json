    "vite": "^7.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite-plugin-pwa": "^1.0.3",
    "xlsx": "^0.18.5",
    "vitest": "^3.2.4"
  },
  "type": "module"

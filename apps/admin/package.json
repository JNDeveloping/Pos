{
  "name": "@rincon/admin",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "predev": "node ../../scripts/clean-legacy-offline.mjs && node ../../scripts/assert-release.mjs",
    "dev": "vite",
    "prebuild": "node ../../scripts/clean-legacy-offline.mjs && node ../../scripts/assert-release.mjs",
    "build": "tsc -b && vite build",
